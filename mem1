        src: "https://static.wixstatic.com/media/4657a4_a855552b97134fbca05c9e79b3b5f440~mv2.jpeg",
        caption: "Walsall Aces Tennis Club",
        description: "Club Gallery"
    },
    {
        src: "https://static.wixstatic.com/media/4657a4_5a878c3a378e4101966aadd5df364d5f~mv2.jpg",
        caption: "Walsall Aces Tennis Club",
        description: "Club Gallery"
    }
];

const GALLERY_STORAGE_KEY =
    "walsall-aces-gallery-comments-v1";

const clubGallery =
    document.getElementById("clubGallery");

const galleryStage =
    document.getElementById("galleryStage");

const openGalleryButton =
    document.getElementById("openGalleryButton");

const closeGalleryButton =
    document.getElementById("closeGalleryButton");

const galleryPrev =
    document.getElementById("galleryPrev");

const galleryNext =
    document.getElementById("galleryNext");

const galleryDots =
    document.getElementById("galleryDots");

const galleryNumber =
    document.getElementById("galleryNumber");

const galleryCaption =
    document.getElementById("galleryCaption");

const galleryDescription =
    document.getElementById("galleryDescription");

const galleryProgress =
    document.getElementById("galleryProgress");

const galleryFullscreenButton =
    document.getElementById("galleryFullscreenButton");

const galleryCommentsButton =
    document.getElementById("galleryCommentsButton");

const galleryCommentsPanel =
    document.getElementById("galleryCommentsPanel");

const closeCommentsButton =
    document.getElementById("closeCommentsButton");

const galleryCommentsList =
    document.getElementById("galleryCommentsList");

const galleryCommentForm =
    document.getElementById("galleryCommentForm");

const galleryCommentName =
    document.getElementById("galleryCommentName");

const galleryCommentText =
    document.getElementById("galleryCommentText");

let galleryIndex = 0;
let galleryTimer = null;
let galleryProgressTimer = null;
let galleryTouchStartX = null;
let galleryPreviousFocus = null;

const GALLERY_INTERVAL = 7000;


/* Build slides — contained photo + blurred cinematic backdrop */

GALLERY_IMAGES.forEach(function(photo, index) {

    const slide =
        document.createElement("div");

    slide.className = "gallery-slide";

    slide.dataset.index = index;

    const blur =
        document.createElement("div");

    blur.className = "gallery-blur";
    blur.setAttribute("aria-hidden", "true");
    blur.style.backgroundImage =
        'url("' + photo.src + '")';

    const vignette =
        document.createElement("div");

    vignette.className = "gallery-vignette";
    vignette.setAttribute("aria-hidden", "true");

    const frame =
        document.createElement("div");

    frame.className = "gallery-photo-frame";

    const image =
        document.createElement("img");

    image.className = "gallery-photo";
    image.src = photo.src;
    image.alt = photo.caption;
    image.draggable = false;
    image.decoding = "async";

    if (index === 0) {

        image.loading = "eager";

    } else {

        image.loading = "lazy";

    }

    frame.appendChild(image);
    slide.appendChild(blur);
    slide.appendChild(vignette);
    slide.appendChild(frame);

    galleryStage.appendChild(slide);


    const dot =
        document.createElement("button");

    dot.type = "button";
    dot.className = "gallery-dot";
    dot.dataset.index = index;

    dot.setAttribute(
        "aria-label",
        "View photograph " + (index + 1)
    );

    dot.addEventListener(
        "click",
        function() {

            showGallerySlide(index, true);

        }
    );

    galleryDots.appendChild(dot);

});


const gallerySlides =
    Array.from(
        document.querySelectorAll(".gallery-slide")
    );

const galleryDotButtons =
    Array.from(
        document.querySelectorAll(".gallery-dot")
    );


function showGallerySlide(
    index,
    restartTimer = false
) {

    if (!GALLERY_IMAGES.length) {
        return;
    }

    galleryIndex =
        (index + GALLERY_IMAGES.length)
        % GALLERY_IMAGES.length;


    gallerySlides.forEach(
        function(slide, slideIndex) {

            const isActive =
                slideIndex === galleryIndex;

            slide.classList.toggle(
                "active",
                isActive
            );

            /*
             * Restart the subtle zoom each time
             * a photograph becomes visible.
             */

            if (isActive) {

                const photo =
                    slide.querySelector(
                        ".gallery-photo"
                    );

                const blur =
                    slide.querySelector(
                        ".gallery-blur"
                    );

                [photo, blur].forEach(
                    function(node) {

                        if (!node) {
                            return;
                        }

                        node.style.animation = "none";

                        void node.offsetWidth;

                        node.style.animation = "";

                    }
                );

            }

        }
    );


    galleryDotButtons.forEach(
        function(dot, dotIndex) {

            dot.classList.toggle(
                "active",
                dotIndex === galleryIndex
            );

        }
    );


    const photo =
        GALLERY_IMAGES[galleryIndex];


    galleryNumber.textContent =
        String(galleryIndex + 1).padStart(2, "0")
        + " / "
        + String(GALLERY_IMAGES.length).padStart(2, "0");


    galleryCaption.textContent =
        photo.caption;

    galleryDescription.textContent =
        photo.description;


    renderGalleryComments();


    if (restartTimer) {

        startGalleryAutoplay();

    }

}


function nextGallerySlide() {

    if (
        galleryCommentsPanel.classList.contains("open")
    ) {

        return;

    }

    showGallerySlide(
        galleryIndex + 1,
        true
    );

}


function previousGallerySlide() {

    if (
        galleryCommentsPanel.classList.contains("open")
    ) {

        return;

    }

    showGallerySlide(
        galleryIndex - 1,
        true
    );

}


function commentsHoldSlideshow() {

    const active =
        document.activeElement;

    return galleryCommentsPanel.classList.contains("open")
        || galleryCommentsPanel.matches(":hover")
        || galleryCommentsButton.matches(":hover")
        || (galleryCommentForm && galleryCommentForm.matches(":hover"))
        || (active && galleryCommentsPanel.contains(active));

}


function startGalleryAutoplay() {

    if (commentsHoldSlideshow()) {

        stopGalleryAutoplay();

        return;

    }

    stopGalleryAutoplay();

    let startedAt =
        Date.now();

    galleryProgress.style.width = "0%";


    galleryTimer =
        setInterval(
            function() {

                nextGallerySlide();

                startedAt =
                    Date.now();

            },
            GALLERY_INTERVAL
        );


    galleryProgressTimer =
        setInterval(
            function() {

                const elapsed =
                    Date.now() - startedAt;

                const percent =
                    Math.min(
                        100,
                        (elapsed / GALLERY_INTERVAL) * 100
                    );

                galleryProgress.style.width =
                    percent + "%";

            },
            100
        );

}


function stopGalleryAutoplay() {

    clearInterval(galleryTimer);
    clearInterval(galleryProgressTimer);

    galleryTimer = null;
    galleryProgressTimer = null;

    galleryProgress.style.width =
        "0%";

}


function openGallery() {

    galleryPreviousFocus =
        document.activeElement;

    clubGallery.classList.add(
        "gallery-open"
    );

    clubGallery.setAttribute(
        "aria-hidden",
        "false"
    );

    document.body.classList.add(
        "gallery-is-open"
    );

    showGallerySlide(
        galleryIndex,
        false
    );

    startGalleryAutoplay();

    closeGalleryButton.focus();

    refreshGalleryComments();

}


function closeGallery() {

    clubGallery.classList.remove(
        "gallery-open"
    );

    clubGallery.setAttribute(
        "aria-hidden",
        "true"
    );

    document.body.classList.remove(
        "gallery-is-open"
    );

    closeCommentsPanel();

    stopGalleryAutoplay();


    if (
        document.fullscreenElement
        && document.exitFullscreen
    ) {

        document.exitFullscreen()
            .catch(function() {});

    }


    if (
        galleryPreviousFocus
        && typeof galleryPreviousFocus.focus === "function"
    ) {

        galleryPreviousFocus.focus();

    }

}


openGalleryButton.addEventListener(
    "click",
    openGallery
);


closeGalleryButton.addEventListener(
    "click",
    closeGallery
);


galleryPrev.addEventListener(
    "click",
    previousGallerySlide
);


galleryNext.addEventListener(
    "click",
    nextGallerySlide
);


/* Full browser screen when supported */

galleryFullscreenButton.addEventListener(
    "click",
    function() {

        if (!document.fullscreenElement) {

            if (
                clubGallery.requestFullscreen
            ) {

                clubGallery
                    .requestFullscreen()
                    .catch(function() {});

            }

        } else if (
            document.exitFullscreen
        ) {

            document.exitFullscreen()
                .catch(function() {});

        }

    }
);


/* Keyboard controls */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            !clubGallery.classList.contains(
                "gallery-open"
            )
        ) {

            return;

        }


        if (event.key === "Escape") {

            if (
                galleryCommentsPanel.classList.contains(
                    "open"
                )
            ) {

                closeCommentsPanel();

            } else {

                closeGallery();

            }

            return;

        }


        if (
            galleryCommentsPanel.classList.contains("open")
        ) {

            return;

        }


        if (event.key === "ArrowRight") {

            event.preventDefault();

            nextGallerySlide();

        }


        if (event.key === "ArrowLeft") {

            event.preventDefault();

            previousGallerySlide();

        }

    }
);


/* Touch / swipe */

galleryStage.addEventListener(
    "touchstart",
    function(event) {

        if (event.touches.length === 1) {

            galleryTouchStartX =
                event.touches[0].clientX;

        }

    },
    { passive: true }
);


galleryStage.addEventListener(
    "touchend",
    function(event) {

        if (
            galleryTouchStartX === null
            || event.changedTouches.length !== 1
        ) {

            return;

        }

        const endX =
            event.changedTouches[0].clientX;

        const distance =
            endX - galleryTouchStartX;

        galleryTouchStartX = null;


        if (Math.abs(distance) < 45) {
            return;
        }


        if (
            galleryCommentsPanel.classList.contains("open")
        ) {

            return;

        }


        if (distance < 0) {

            nextGallerySlide();

        } else {

            previousGallerySlide();

        }

    },
    { passive: true }
);


/* Pause autoplay while interacting with controls */

galleryStage.addEventListener(
    "mouseenter",
    stopGalleryAutoplay
);

galleryStage.addEventListener(
    "mouseleave",
    function() {

        if (
            event.relatedTarget
            && (
                galleryCommentsPanel.contains(event.relatedTarget)
                || galleryCommentsButton.contains(event.relatedTarget)
            )
        ) {

            stopGalleryAutoplay();

            return;

        }


        if (
            clubGallery.classList.contains(
                "gallery-open"
            )
            && !commentsHoldSlideshow()
        ) {

            startGalleryAutoplay();

        }

    }
);


galleryCommentsButton.addEventListener(
    "mouseenter",
    stopGalleryAutoplay
);

galleryCommentsPanel.addEventListener(
    "mouseenter",
    stopGalleryAutoplay
);

document.getElementById("galleryCommentsLive").addEventListener(
    "mouseenter",
    stopGalleryAutoplay
);

galleryCommentForm.addEventListener(
    "focusin",
    stopGalleryAutoplay
);

galleryCommentsButton.addEventListener(
    "mouseleave",
    function(event) {

        if (
            event.relatedTarget
            && galleryCommentsPanel.contains(event.relatedTarget)
        ) {

            stopGalleryAutoplay();

            return;

        }


        if (
            clubGallery.classList.contains("gallery-open")
            && !commentsHoldSlideshow()
        ) {

            startGalleryAutoplay();

        }

    }
);

galleryCommentsPanel.addEventListener(
    "mouseleave",
    function() {

        if (
            clubGallery.classList.contains("gallery-open")
            && !commentsHoldSlideshow()
        ) {

            startGalleryAutoplay();

        }

    }
);


/* =========================
   GALLERY COMMENTS
   Shared through the club Google Sheet.
========================= */

let galleryCommentsCache = {};
let galleryCommentsLoading = false;
let commentPhotoIndex = 0;

const galleryCommentNote =
    document.getElementById("galleryCommentNote");


function commentsScriptReady() {

    return Boolean(
        COMMENTS_SCRIPT_URL
        && COMMENTS_SCRIPT_URL.indexOf("PASTE_YOUR") === -1
        && COMMENTS_SCRIPT_URL.indexOf("http") === 0
    );

}


function renderGalleryComments() {

    const photoComments =
        galleryCommentsCache[galleryIndex] || [];


    galleryCommentsList.innerHTML = "";


    if (galleryCommentsLoading && !photoComments.length) {

        const loading =
            document.createElement("p");

        loading.className = "gallery-no-comments";
        loading.textContent = "Loading member comments...";

        galleryCommentsList.appendChild(loading);

        return;

    }


    if (!commentsScriptReady()) {

        const missing =
            document.createElement("p");

        missing.className = "gallery-no-comments";
        missing.textContent =
            "Shared comments are not connected yet. Paste the Google Apps Script web app URL into COMMENTS_SCRIPT_URL.";

        galleryCommentsList.appendChild(missing);

        return;

    }


    if (!photoComments.length) {

        const empty =
            document.createElement("p");

        empty.className = "gallery-no-comments";
        empty.textContent =
            "No member comments yet. Be the first to add one.";

        galleryCommentsList.appendChild(empty);

        return;

    }


    photoComments.slice().reverse().forEach(
        function(comment) {

            const item =
                document.createElement("div");

            item.className = "gallery-comment";


            const name =
                document.createElement("strong");

            name.textContent = comment.name;


            const text =
                document.createElement("p");

            text.textContent = comment.text;


            item.appendChild(name);
            item.appendChild(text);

            galleryCommentsList.appendChild(item);

        }
    );

}


async function refreshGalleryComments() {

    if (!commentsScriptReady()) {

        renderGalleryComments();

        return;

    }


    galleryCommentsLoading = true;

    renderGalleryComments();


    try {

        const response =
            await fetch(
                COMMENTS_SCRIPT_URL
                + "?action=list&key="
                + encodeURIComponent(COMMENT_KEY)
                + "&t="
                + Date.now()
            );


        if (!response.ok) {

            throw new Error(
                "Comments could not be loaded."
            );

        }


        const result =
            await response.json();


        if (result.result !== "success") {

            throw new Error(
                result.message || "Comments could not be loaded."
            );

        }


        galleryCommentsCache = {};


        (result.comments || []).forEach(
            function(comment) {

                const index =
                    Number(comment.photoIndex);


                if (!galleryCommentsCache[index]) {

                    galleryCommentsCache[index] = [];

                }


                galleryCommentsCache[index].push({
                    name: comment.name,
                    text: comment.text,
                    createdAt: comment.createdAt
                });

            }
        );

    } catch (error) {

        console.error(error);

        galleryCommentsList.innerHTML = "";

        const failed =
            document.createElement("p");

        failed.className = "gallery-no-comments";
        failed.textContent =
            "Comments could not be loaded from the club sheet. Please try again.";

        galleryCommentsList.appendChild(failed);

        galleryCommentsLoading = false;

        return;

    }


    galleryCommentsLoading = false;

    renderGalleryComments();

}


function openCommentsPanel() {

    galleryCommentsPanel.classList.add(
        "open"
    );

    galleryCommentsPanel
        .setAttribute(
            "aria-hidden",
            "false"
        );

    commentPhotoIndex = galleryIndex;

    stopGalleryAutoplay();

    if (galleryCommentNote) {

        galleryCommentNote.textContent =
            "Commenting on photograph "
            + String(commentPhotoIndex + 1).padStart(2, "0")
            + ". The slideshow is paused until you close this panel.";

    }

    galleryCommentName.focus();

    refreshGalleryComments();

}


function closeCommentsPanel() {

    galleryCommentsPanel.classList.remove(
        "open"
    );

    galleryCommentsPanel
        .setAttribute(
            "aria-hidden",
            "true"
        );


    if (
        clubGallery.classList.contains("gallery-open")
    ) {

        startGalleryAutoplay();

    }

}


galleryCommentsButton.addEventListener(
    "click",
    openCommentsPanel
);


closeCommentsButton.addEventListener(
    "click",
    closeCommentsPanel
);


galleryCommentForm.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();


        const name =
            galleryCommentName.value
                .trim();

        const text =
            galleryCommentText.value
                .trim();


        if (!name || !text) {

            return;

        }


        if (!commentsScriptReady()) {

            alert(
                "Shared comments are not connected yet."
            );

            return;

        }


        const submit =
            galleryCommentForm.querySelector(
                ".gallery-comment-submit"
            );

        submit.disabled = true;
        submit.textContent = "Posting...";


        try {

            const photo =
                GALLERY_IMAGES[commentPhotoIndex] || {};

            const formData =
                new FormData();

            formData.append("action", "comment");
            formData.append("key", COMMENT_KEY);
            formData.append("photoIndex", String(commentPhotoIndex));
            formData.append(
                "photoCaption",
                photo.caption || ""
            );
            formData.append("name", name);
            formData.append("text", text);


            const response =
                await fetch(
                    COMMENTS_SCRIPT_URL,
                    {
                        method: "POST",
                        body: formData
                    }
                );


            if (!response.ok) {

                throw new Error(
                    "Comment could not be saved."
                );

            }


            const result =
                await response.json();


            if (result.result !== "success") {

                throw new Error(
                    result.message || "Comment could not be saved."
                );

            }


            galleryCommentText.value = "";

            await refreshGalleryComments();

        } catch (error) {

            console.error(error);

            alert(
                "The comment could not be saved to the club sheet. Please try again."
            );

        } finally {

            submit.disabled = false;
            submit.textContent = "Post Comment";

        }

    }
);


/* Pre-fill member name when available */

if (galleryCommentName && membershipForm) {

    membershipForm
        .querySelector("#fullName")
        ?.addEventListener(
            "input",
            function() {

                if (
                    !galleryCommentName.value
                ) {

                    galleryCommentName.value =
                        this.value;

                }

            }
        );

}


/* Initialise gallery */

showGallerySlide(
    0,
    false
);



/* =========================
   SVG TEXT SAFETY
========================= */

function escapeSvgText(value) {

    return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&apos;");

}


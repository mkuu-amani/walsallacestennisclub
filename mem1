            "↻ Refreshing Calendar...";


        /*
         * Refresh whichever calendar is
         * currently visible.
         */

        const isMobile =
            window.matchMedia(
                "(max-width: 700px)"
            ).matches;


        const activeCalendar =
            isMobile
            ? calendarMobile
            : calendarDesktop;


        /*
         * Reassigning the iframe source forces

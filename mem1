<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<meta name="robots"
      content="noindex,nofollow">

<title>Members | Walsall Aces Tennis Club</title>

<style>

:root {
    --navy: #071a33;
    --navy-light: #0d2b4d;
    --green: #25a65a;
    --green-dark: #168447;
    --white: #ffffff;
    --light: #f4f7f9;
    --text: #1c2733;
    --muted: #66717d;
    --border: #dce3e8;
    --shadow: 0 15px 40px rgba(0,0,0,0.12);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;
    background: var(--light);
    color: var(--text);
}


/* =========================
   PASSWORD GATE
========================= */

#passwordGate {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 25px;

    background:
        linear-gradient(
            rgba(7,26,51,0.92),
            rgba(7,26,51,0.96)
        ),
        url("https://static.wixstatic.com/media/4657a4_5736a5188634477da5ff9f150b22b8c2~mv2.jpg")
        center / cover no-repeat;
}

.password-box {
    width: 100%;
    max-width: 430px;

    padding: 40px 30px;

    background: rgba(255,255,255,0.98);

    border-radius: 20px;

    box-shadow: 0 25px 70px rgba(0,0,0,0.3);

    text-align: center;
}

.password-logo {
    width: 110px;
    height: 110px;

    object-fit: contain;

    margin-bottom: 15px;
}

.password-box h1 {
    margin: 0 0 8px;

    color: var(--navy);

    font-size: 28px;
}

.password-box p {
    margin: 0 0 25px;

    color: var(--muted);

    line-height: 1.5;
}

.password-box input {
    width: 100%;

    padding: 14px 16px;

    border: 1px solid var(--border);
    border-radius: 10px;

    font-size: 16px;

    outline: none;
}

.password-box input:focus {
    border-color: var(--green);

    box-shadow:
        0 0 0 3px rgba(37,166,90,0.12);
}

.password-button {
    width: 100%;

    margin-top: 14px;

    padding: 14px 20px;

    border: 0;
    border-radius: 10px;

    background: var(--green);
    color: white;

    font-size: 16px;
    font-weight: 700;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.password-button:hover {
    background: var(--green-dark);

    transform: translateY(-1px);
}

.password-error {
    min-height: 22px;

    margin-top: 12px;

    color: #c62828;

    font-size: 14px;
}


/* =========================
   MAIN PAGE
========================= */

#membersPage {
    display: none;
}

.hero {
    position: relative;

    min-height: 330px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 50px 20px;

    background:
        linear-gradient(
            rgba(7,26,51,0.78),
            rgba(7,26,51,0.88)
        ),
        url("https://static.wixstatic.com/media/4657a4_5736a5188634477da5ff9f150b22b8c2~mv2.jpg")
        center / cover no-repeat;

    color: white;

    text-align: center;
}

.hero-content {
    max-width: 850px;
}

.hero-logo {
    width: 115px;
    height: 115px;

    object-fit: contain;

    margin-bottom: 15px;

    filter:
        drop-shadow(0 8px 20px rgba(0,0,0,0.3));
}

.hero h1 {
    margin: 0;

    font-size: clamp(34px, 6vw, 58px);

    line-height: 1.05;

    font-weight: 800;
}

.hero p {
    margin: 15px 0 0;

    font-size: 18px;

    opacity: 0.92;
}


/* =========================
   NAV
========================= */

.nav {
    background: var(--navy);

    padding: 12px 20px;

    position: sticky;
    top: 0;

    z-index: 100;
}

.nav-inner {
    max-width: 1100px;

    margin: auto;

    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 15px;
}

.nav-brand {
    color: white;

    text-decoration: none;

    font-weight: 800;

    font-size: 16px;
}

.nav-links {
    display: flex;

    gap: 18px;

    flex-wrap: wrap;
}

.nav-links a {
    color: white;

    text-decoration: none;

    font-size: 14px;

    opacity: 0.9;
}

.nav-links a:hover {
    color: #7de0a1;
}


/* =========================
   CONTENT
========================= */

.container {
    width: min(1100px, calc(100% - 30px));

    margin: 40px auto 70px;
}

.card {
    background: white;

    border-radius: 18px;

    box-shadow: var(--shadow);

    overflow: hidden;

    margin-bottom: 30px;
}

.card-header {
    padding: 25px 30px;

    background: var(--navy);

    color: white;
}

.card-header h2 {
    margin: 0;

    font-size: 25px;
}

.card-header p {
    margin: 8px 0 0;

    opacity: 0.82;

    line-height: 1.5;
}

.card-body {
    padding: 30px;
}


/* =========================
   CALENDAR
========================= */

.calendar-wrapper {
    width: 100%;
    max-width: 100%;

    height: 650px;
    overflow: hidden;

    border-radius: 12px;

    border: 1px solid var(--border);

    background: white;
}

.calendar-frame {
    display: block;

    width: 100%;
    max-width: 100%;

    height: 710px;
    margin-bottom: -60px;

    border: 0;
}

.calendar-mobile {
    display: none;
}


/* CALENDAR REFRESH BUTTON */

.calendar-refresh-row {
    display: flex;

    justify-content: center;

    margin-top: 15px;
}

.calendar-refresh-button {
    border: 0;

    border-radius: 10px;

    padding: 11px 18px;

    background: var(--navy);

    color: white;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.2s ease,
        opacity 0.2s ease;
}

.calendar-refresh-button:hover {
    background: var(--navy-light);

    transform: translateY(-1px);
}

.calendar-refresh-button:active {
    transform: translateY(0);
}

.calendar-refresh-button.refreshing {
    opacity: 0.65;

    cursor: wait;
}


/* =========================
   FORM
========================= */

.form-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 20px;
}

.form-group {
    display: flex;

    flex-direction: column;

    gap: 7px;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    font-weight: 700;

    font-size: 14px;

    color: var(--navy);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;

    padding: 13px 14px;

    border: 1px solid var(--border);

    border-radius: 9px;

    font-family: inherit;

    font-size: 15px;

    background: white;

    outline: none;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: var(--green);

    box-shadow:
        0 0 0 3px rgba(37,166,90,0.12);
}

.form-group textarea {
    min-height: 110px;

    resize: vertical;
}

.required {
    color: #c62828;
}

.checkbox-row {
    display: flex;

    align-items: flex-start;

    gap: 10px;

    margin-top: 8px;
}

.checkbox-row input {
    margin-top: 4px;

    width: 17px;
    height: 17px;

    flex-shrink: 0;
}

.checkbox-row label {
    font-size: 14px;

    line-height: 1.5;

    color: var(--text);

    font-weight: 500;
}

.form-note {
    margin-top: 25px;

    padding: 15px;

    border-radius: 10px;

    background: #f0f7f3;

    border-left: 4px solid var(--green);

    color: #315540;

    font-size: 14px;

    line-height: 1.5;
}

.submit-row {
    margin-top: 25px;

    display: flex;

    justify-content: flex-start;
}

.submit-button {
    border: 0;

    border-radius: 10px;

    padding: 14px 24px;

    background: var(--green);

    color: white;

    font-size: 16px;

    font-weight: 800;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.2s ease,
        opacity 0.2s ease;
}

.submit-button:hover {
    background: var(--green-dark);

    transform: translateY(-1px);
}

.submit-button:disabled {
    opacity: 0.6;

    cursor: wait;

    transform: none;
}

.form-status {
    margin-top: 18px;

    padding: 13px 15px;

    border-radius: 9px;

    display: none;

    line-height: 1.5;
}

.form-status.success {
    display: block;

    background: #eaf7ef;

    color: #166534;

    border: 1px solid #b8e2c7;
}

.form-status.error {
    display: block;

    background: #fff0f0;

    color: #a61b1b;

    border: 1px solid #efb7b7;
}


/* =========================
   DIGITAL MEMBERSHIP CARD
========================= */

.membership-result {
    display: none;

    margin-top: 30px;

    padding-top: 30px;

    border-top: 1px solid var(--border);

    animation: cardReveal 0.5s ease;
}

@keyframes cardReveal {
    from {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.membership-result h3 {
    margin: 0 0 8px;

    color: var(--navy);

    font-size: 25px;
}

.membership-result-intro {
    margin: 0 0 22px;

    color: var(--muted);

    line-height: 1.5;
}


/* Card preview */

.digital-card {
    width: 100%;

    max-width: 720px;

    margin: 0 auto 25px;

    padding: 28px;

    border-radius: 20px;

    position: relative;

    overflow: hidden;

    color: white;

    background:
        linear-gradient(
            135deg,
            #071a33 0%,
            #0d2b4d 55%,
            #126b40 100%
        );

    box-shadow:
        0 18px 45px rgba(7,26,51,0.28);
}

.digital-card::before {
    content: "";

    position: absolute;

    width: 280px;
    height: 280px;

    border-radius: 50%;

    right: -100px;
    top: -120px;

    background:
        rgba(37,166,90,0.18);
}

.digital-card::after {
    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    border-radius: 50%;

    left: -100px;
    bottom: -110px;

    background:
        rgba(255,255,255,0.05);
}

.digital-card-content {
    position: relative;

    z-index: 2;
}

.digital-card-top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 30px;
}

.digital-card-brand {
    display: flex;

    align-items: center;

    gap: 15px;
}

.digital-card-logo {
    width: 70px;
    height: 70px;

    object-fit: contain;

    flex-shrink: 0;
}

.digital-card-club {
    font-size: 18px;

    font-weight: 900;

    letter-spacing: 0.5px;
}

.digital-card-title {
    font-size: 12px;

    letter-spacing: 2px;

    text-transform: uppercase;

    opacity: 0.72;

    margin-top: 3px;
}

.digital-card-badge {
    padding: 7px 11px;

    border-radius: 999px;

    background: rgba(37,166,90,0.95);

    color: white;

    font-size: 11px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 0.6px;

    white-space: nowrap;
}

.digital-card-name {
    font-size: clamp(26px, 5vw, 38px);

    font-weight: 800;

    line-height: 1.1;

    margin-bottom: 25px;

    word-break: break-word;
}

.digital-card-details {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 15px;
}

.digital-card-detail-label {
    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 1.2px;

    opacity: 0.65;

    margin-bottom: 5px;
}

.digital-card-detail-value {
    font-size: 15px;

    font-weight: 750;

    word-break: break-word;
}


/* Card buttons */

.card-actions {
    display: flex;

    justify-content: center;

    gap: 12px;

    flex-wrap: wrap;

    margin-top: 22px;
}

.download-card-button,
.clear-form-button {
    border: 0;

    border-radius: 10px;

    padding: 13px 20px;

    font-size: 15px;

    font-weight: 800;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        opacity 0.2s ease,
        background 0.2s ease;
}

.download-card-button {
    background: var(--green);

    color: white;
}

.download-card-button:hover {
    background: var(--green-dark);

    transform: translateY(-1px);
}

.clear-form-button {
    background: #e8edf1;

    color: var(--navy);
}

.clear-form-button:hover {
    background: #dbe2e7;

    transform: translateY(-1px);
}

.download-card-button:disabled {
    opacity: 0.65;

    cursor: wait;

    transform: none;
}

.card-instruction {
    text-align: center;

    color: var(--muted);

    font-size: 13px;

    margin: 15px auto 0;

    max-width: 600px;

    line-height: 1.5;
}


/* =========================
   FOOTER
========================= */

footer {
    background: var(--navy);

    color: white;

    text-align: center;

    padding: 30px 20px;

    font-size: 14px;
}

footer a {
    color: #7de0a1;

    text-decoration: none;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 700px) {

    .hero {
        min-height: 290px;
    }

    .hero-logo {
        width: 90px;
        height: 90px;
    }

    .nav-inner {
        flex-direction: column;
    }

    .nav-links {
        justify-content: center;
    }

    .card-body {
        padding: 22px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }


    /* MOBILE CALENDAR */

    .calendar-desktop {
        display: none !important;
    }

    .calendar-mobile {
        display: block !important;

        width: 100%;
        max-width: 100%;

        height: 650px;
    }


    .digital-card {
        padding: 22px;
    }

    .digital-card-top {
        align-items: flex-start;
    }

    .digital-card-badge {
        display: none;
    }

    .digital-card-details {
        grid-template-columns: 1fr;
    }

    .digital-card-name {
        font-size: 28px;
    }

}


/* =========================
   CLUB GALLERY LAUNCHER
========================= */

.gallery-launch-card {
    position: relative;
    overflow: hidden;
    margin-bottom: 30px;
    min-height: 270px;
    border-radius: 18px;
    box-shadow: var(--shadow);
    background:
        linear-gradient(135deg, rgba(7,26,51,.94), rgba(13,43,77,.82)),
        url("https://static.wixstatic.com/media/4657a4_0ed4db30e72a42ec96d0c0968f1794cb~mv2.jpg")
        center / cover no-repeat;
    color: white;
}

.gallery-launch-inner {
    min-height: 270px;
    padding: 42px 34px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    position: relative;
    z-index: 1;
}

.gallery-kicker {
    margin: 0 0 8px;
    color: #7de0a1;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.gallery-launch-inner h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
}

.gallery-launch-inner p {
    max-width: 650px;
    margin: 12px 0 22px;
    line-height: 1.6;
    opacity: .9;
}

.gallery-open-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 0;
    border-radius: 999px;
    padding: 13px 21px;
    background: var(--green);
    color: white;
    font-family: inherit;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0,0,0,.25);
    transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
}

.gallery-open-button:hover {
    background: var(--green-dark);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0,0,0,.3);
}

.gallery-open-button:active {
    transform: translateY(0);
}


/* =========================
   FULL-SCREEN GALLERY
   Entire photograph always visible (object-fit: contain).
   Blurred cinematic copy fills the stage behind it.
========================= */

#clubGallery {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    background: #02070d;
    color: white;
    overflow: hidden;
    -webkit-text-size-adjust: 100%;
}

#clubGallery.gallery-open {
    display: block;
}

#clubGallery:fullscreen,
#clubGallery:-webkit-full-screen {
    width: 100%;
    height: 100%;
    min-height: 100%;
    background: #02070d;
}

.gallery-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #02070d;
    touch-action: pan-y;
}

.gallery-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity .7s ease;
    pointer-events: none;
    z-index: 0;
}

.gallery-slide.active {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
}

/* Blurred cinematic backdrop — same photo, cropped only in the background */
.gallery-blur {
    position: absolute;
    inset: -12%;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    filter: blur(42px) saturate(1.22) brightness(.62);
    transform: scale(1.14);
    opacity: .95;
    z-index: 0;
    pointer-events: none;
}

.gallery-slide.active .gallery-blur {
    animation: galleryBlurDrift 7.2s ease-out forwards;
}

@keyframes galleryBlurDrift {
    from { transform: scale(1.2); }
    to { transform: scale(1.1); }
}

.gallery-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
        linear-gradient(
            to bottom,
            rgba(2,7,13,.62) 0%,
            rgba(2,7,13,.12) 18%,
            rgba(2,7,13,0) 36%,
            rgba(2,7,13,0) 62%,
            rgba(2,7,13,.55) 82%,
            rgba(2,7,13,.82) 100%
        );
}

/* Box the photograph must fit inside — never cropped, never under the chrome */
.gallery-photo-frame {
    position: absolute;
    z-index: 2;
    left: 50%;
    transform: translateX(-50%);
    top: calc(72px + env(safe-area-inset-top));
    bottom: calc(158px + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(
        1280px,
        calc(100vw - 390px - env(safe-area-inset-left) - env(safe-area-inset-right))
    );
    height: auto;
}

.gallery-photo {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    background: transparent;
    border-radius: 2px;
    box-shadow:
        0 24px 70px rgba(0,0,0,.45),
        0 0 0 1px rgba(255,255,255,.06);
    user-select: none;
    -webkit-user-drag: none;
    transform: scale(1.035);
}

.gallery-slide.active .gallery-photo {
    animation: galleryKenBurns 7.2s ease-out forwards;
}

@keyframes galleryKenBurns {
    from { transform: scale(1.045); }
    to { transform: scale(1); }
}

.gallery-topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding:
        calc(16px + env(safe-area-inset-top))
        calc(20px + env(safe-area-inset-right))
        12px
        calc(20px + env(safe-area-inset-left));
    pointer-events: none;
}

.gallery-title {
    pointer-events: auto;
}

.gallery-title strong {
    display: block;
    font-size: 16px;
    text-shadow: 0 2px 12px rgba(0,0,0,.45);
}

.gallery-title span {
    display: block;
    margin-top: 3px;
    color: rgba(255,255,255,.75);
    font-size: 12px;
}

.gallery-close,
.gallery-fullscreen,
.gallery-arrow {
    border: 1px solid rgba(255,255,255,.22);
    background: rgba(0,0,0,.38);
    color: white;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: pointer;
}

.gallery-close,
.gallery-fullscreen {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 21px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
}

.gallery-top-actions {
    display: flex;
    gap: 9px;
}

.gallery-close:hover,
.gallery-fullscreen:hover,
.gallery-arrow:hover {
    background: rgba(37,166,90,.8);
}

.gallery-arrow {
    position: absolute;
    z-index: 6;
    top: 46%;
    width: 52px;
    height: 72px;
    transform: translateY(-50%);
    border-radius: 16px;
    font-size: 35px;
    line-height: 1;
}

.gallery-prev {
    left: max(18px, calc(env(safe-area-inset-left) + 12px));
}

.gallery-next {

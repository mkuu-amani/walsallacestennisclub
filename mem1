membershipForm.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();


        /*
         * Browser validation
         */

        if (!membershipForm.checkValidity()) {

            membershipForm.reportValidity();

            return;

        }


        submitButton.disabled = true;

        submitButton.textContent =
            "Submitting Membership Details...";


        formStatus.textContent =
            "Please wait while your membership is created.";

        formStatus.className =
            "form-status success";


        try {

            const formData =
                new FormData(membershipForm);


            const response =
                await fetch(
                    SCRIPT_URL,
                    {
                        method: "POST",
                        body: formData
                    }
                );


            if (!response.ok) {

                throw new Error(
                    "Network response was not successful."
                );

            }


            const result =
                await response.json();


            if (result.result === "success") {


                /*
                 * Populate the digital membership card
                 */

                cardMemberName.textContent =
                    result.memberName || "";

                cardMembershipType.textContent =
                    result.membershipType || "";

                cardMembershipNumber.textContent =
                    result.membershipNumber || "";

                cardMembershipStatus.textContent =
                    result.status || "Active";


                /*
                 * Show confirmation
                 */

                formStatus.textContent =
                    "Membership created successfully. Your digital membership card is ready below.";

                formStatus.className =
                    "form-status success";


                /*
                 * Show card area
                 */

                membershipResult.style.display =
                    "block";


                /*
                 * Prevent another submission while
                 * the card is waiting to be downloaded.
                 */

                submitButton.disabled = true;

                submitButton.textContent =
                    "Membership Created";


                /*
                 * Bring the membership card into view
                 */

                setTimeout(
                    function() {

                        membershipResult.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });

                    },
                    150
                );


            } else {

                throw new Error(
                    result.message ||
                    result.error ||
                    "Submission failed."
                );

            }


        } catch (error) {

            console.error(error);

            formStatus.textContent =
                "Sorry, there was a problem submitting the form. Please try again.";

            formStatus.className =
                "form-status error";


            submitButton.disabled =
                false;

            submitButton.textContent =
                "Submit Membership Details";

        }

    }
);


/* =========================
   PREPARE CLUB LOGO
========================= */

async function prepareClubLogo() {

    /*
     * If we have already converted the logo,
     * use the cached version.
     */

    if (clubLogoDataUrl) {

        return clubLogoDataUrl;

    }


    try {

        /*
         * Fetch the logo from Wix.
         */

        const response =
            await fetch(
                CLUB_LOGO_URL
            );


        if (!response.ok) {

            throw new Error(
                "Logo could not be loaded."
            );

        }


        /*
         * Convert the downloaded image
         * into a Blob.
         */

        const blob =
            await response.blob();


        /*
         * Convert the Blob into a data URL.
         *
         * This embeds the actual logo inside
         * the downloaded SVG membership card.
         */

        return await new Promise(
            function(resolve, reject) {

                const reader =
                    new FileReader();


                reader.onloadend =
                    function() {

                        clubLogoDataUrl =
                            reader.result;

                        resolve(
                            clubLogoDataUrl
                        );

                    };


                reader.onerror =
                    function(error) {

                        reject(error);

                    };


                reader.readAsDataURL(
                    blob
                );

            }
        );

    } catch (error) {

        console.error(
            "Could not prepare club logo:",
            error
        );


        /*
         * Return an empty string if the logo
         * cannot be prepared.
         */

        return "";

    }

}


